# PyLogGuard v2 - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=attack_logs_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# Loki Configuration
# ============================================================================
LOKI_URL=http://localhost:3100
LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push
LOKI_QUERY_URL=http://localhost:3100/loki/api/v1/query
LOKI_BATCH_SIZE=100
LOKI_TIMEOUT=30

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ORG_ID=1

# ============================================================================
# Application Settings
# ============================================================================
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC

# ============================================================================
# Log Ingestion Settings
# ============================================================================
# Maximum file size to process (in MB)
MAX_LOG_FILE_SIZE=100

# Batch insert size for database operations
BATCH_INSERT_SIZE=1000

# Enable/disable parsers
ENABLE_SNORT_PARSER=true
ENABLE_PROXY_PARSER=true
ENABLE_SYSLOG_PARSER=true
ENABLE_SAMBA_PARSER=true
ENABLE_WIRESHARK_PARSER=true

# ============================================================================
# Alert Configuration
# ============================================================================
# Bruteforce detection threshold
BRUTEFORCE_THRESHOLD=5
BRUTEFORCE_TIME_WINDOW=300

# High severity spike threshold
HIGH_SEVERITY_THRESHOLD=5
HIGH_SEVERITY_TIME_WINDOW=600

# DoS detection threshold (packets per second)
DOS_THRESHOLD=100
DOS_TIME_WINDOW=10

# ============================================================================
# Security Settings
# ============================================================================
# JWT secret for API authentication (if implemented)
JWT_SECRET=your-secret-key-change-this

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# Enable CORS (for API)
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Monitoring & Performance
# ============================================================================
# Enable performance metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ============================================================================
# Email Alerts (Optional - for future implementation)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@pylogguard.local
ALERT_EMAIL_RECIPIENTS=admin@example.com,security@example.com

# ============================================================================
# Slack Alerts (Optional - for future implementation)
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts
SLACK_ENABLE=false

# ============================================================================
# File Paths
# ============================================================================
LOG_DIRECTORY=demo/logs
UPLOAD_DIRECTORY=uploads
EXPORT_DIRECTORY=exports
BACKUP_DIRECTORY=backups

# ============================================================================
# Docker Configuration (used in docker-compose.yml)
# ============================================================================
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=attack_logs_db
MYSQL_USER=pylogguard
MYSQL_PASSWORD=changeme

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug mode (verbose logging)
DEBUG_MODE=false

# Enable SQL query logging
SQL_ECHO=false

# Enable profiling
ENABLE_PROFILING=false
